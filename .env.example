# Contact form email delivery (SMTP2GO — https://smtp2go.com)
# Without SMTP2GO_API_KEY the /api/contact endpoint still validates and accepts
# submissions (logging them server-side) but does not send email.
SMTP2GO_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=hello@scalout.com
# Sender address. The domain must be verified in SMTP2GO or the API accepts the
# request and then reports zero successful recipients.
CONTACT_FROM_EMAIL=Scalout <hello@scalout.com>

# Pulse CRM (Virtual-Office) — mirrors each enquiry into the Deals pipeline.
# Both must be set for the sync to run; with either missing the form still
# works and emails, it just does not create a deal. A failed sync never blocks
# the visitor, so check the server logs for "[contact] Pulse sync failed".
# Origin only, no trailing path — the route appends /public/leads.
PULSE_API_URL=
# Shared HMAC secret. Must match PULSE_SYNC_SECRET in the Pulse backend, or
# Pulse rejects every submission with 401.
PULSE_SYNC_SECRET=

# Public site origin — used for canonical URLs, sitemap, and OG tags.
# Required for any production build. Vercel preview deployments fall back to
# their own deployment URL and serve a robots.txt that disallows everything,
# so previews build without this; production does not.
NEXT_PUBLIC_SITE_URL=https://scalout.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX), from Admin > Data streams.
# Optional — with it unset the site simply reports nothing. gtag.js loads only
# on a production build that also has NEXT_PUBLIC_SITE_URL set, so `next dev`
# and Vercel previews never report against the production property.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID, from the Clarity dashboard under
# Settings > Overview (the value in the install snippet's last argument).
# Optional, and gated exactly like NEXT_PUBLIC_GA_ID: the tag loads only on a
# production build that also has NEXT_PUBLIC_SITE_URL set, so `next dev` and
# Vercel previews never record sessions against the production project.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Tag Manager container ID (GTM-XXXXXXX), shown in the container's
# Workspace header. Optional, and gated exactly like the two IDs above.
# The container loads in addition to the GA and Clarity tags, so do not add a
# GA4 tag inside it while NEXT_PUBLIC_GA_ID is set — that counts every pageview
# twice. Route each vendor through one path only.
NEXT_PUBLIC_GTM_ID=
