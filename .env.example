# Contact form email delivery (Resend — https://resend.com)
# Without RESEND_API_KEY the /api/contact endpoint still validates and accepts
# submissions (logging them server-side) but does not send email.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=hello@scaleout.sg
# Verified sender. onboarding@resend.dev works for testing to the account owner
# only; use an address on a domain you've verified in Resend for production.
CONTACT_FROM_EMAIL=Scalout <onboarding@resend.dev>

# Public site origin — used for canonical URLs, sitemap, and OG tags.
NEXT_PUBLIC_SITE_URL=https://scaleout.example
